# Production environment for the Django backend.
#
# Nothing here is loaded automatically: settings.py reads plain environment
# variables and every one of them has a development default, so a fresh clone
# runs without this file. Use it as the source for `systemd`'s EnvironmentFile=,
# for `set -a; . .env; set +a`, or for your container runtime.

# Generate one per installation, and never reuse the development default:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me

# 0 in production. With DEBUG on, Django serves media/ and staticfiles/ itself
# and leaks tracebacks to visitors.
DJANGO_DEBUG=0

# Comma-separated. Must list every hostname the backend answers on.
DJANGO_ALLOWED_HOSTS=api.example.com

# Comma-separated origins allowed to call the API from a browser. The Next.js
# site calls it server-side, so this only matters for browser-side requests.
DJANGO_CORS_ORIGINS=https://example.com

# Comma-separated, scheme included. Needed for admin logins over HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com

# Admin interface language: ru, en, kg or fr.
DJANGO_LANGUAGE_CODE=ru
