# Where the Django backend runs. The site reads its content and photos from
# here at build time and every 60 seconds afterwards.
#
# Must be reachable from the machine running `next build` and from the running
# Node server. Browsers also hit it directly for photos, so in production it has
# to be a public URL, not an internal one.
API_BASE_URL=https://back.go-kyrgyzstan.com

# Production example:
# API_BASE_URL=https://api.example.com
